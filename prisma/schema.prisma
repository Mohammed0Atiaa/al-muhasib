// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         String   @id @default(cuid())
  userId     String
  companyId  String?
  name       String
  sku        String?  @unique
  price      Decimal  @db.Decimal(18, 3)
  costPrice  Decimal  @default(0) @db.Decimal(18, 3)
  quantity   Int      @default(0)
  lowStockAt Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stocks WarehouseStock[]

  @@index([userId, name])
  @@index([createdAt])
  @@index([companyId])
}

model Company {
  id           String   @id @default(cuid())
  name         String
  baseCurrency String   @default("KWD")
  createdAt    DateTime @default(now())

  memberships   Membership[]
  branches      Branch[]
  warehouses    Warehouse[]
  exchangeRates ExchangeRate[]
  accounts      Account[]
  customers     Customer[]
  counters      DocumentCounter[]
}

model Membership {
  id        String  @id @default(cuid())
  companyId String
  userId    String
  role      String  @default("CASHIER")
  branchId  String?
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, userId])
  @@index([userId])
}

model Branch {
  id        String  @id @default(cuid())
  companyId String
  code      String
  name      String
  isActive  Boolean @default(true)
  company   Company @relation(fields: [companyId], references: [id])

  warehouses Warehouse[]
  counters   DocumentCounter[]

  @@unique([companyId, code])
}

model Warehouse {
  id        String  @id @default(cuid())
  companyId String
  branchId  String
  name      String
  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])

  stocks WarehouseStock[]

  @@index([companyId, branchId])
}

model Currency {
  code     String @id
  name     String
  decimals Int    @default(2)
}

model ExchangeRate {
  id            String   @id @default(cuid())
  companyId     String
  currency      String
  rate          Decimal  @db.Decimal(18, 8)
  effectiveDate DateTime @db.Date
  company       Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, currency, effectiveDate])
}

model Account {
  id        String  @id @default(cuid())
  companyId String
  code      String
  name      String
  type      String
  isActive  Boolean @default(true)
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
}

model Customer {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  phone         String?
  phone2        String?   // رقم الهاتف الثاني
  email         String?   // البريد الإلكتروني
  address       String?   // العنوان بالتفصيل
  notes         String?   // ملاحظات أو بيان خاص
  isBlacklisted Boolean   @default(false) // حالة الحظر
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id])
  invoices      Invoice[] // الربط مع الفواتير

  @@index([companyId, name])
}


model WarehouseStock {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
}

model DocumentCounter {
  id         String  @id @default(cuid())
  companyId  String
  branchId   String
  docType    String
  lastNumber Int     @default(0)
  company    Company @relation(fields: [companyId], references: [id])
  branch     Branch  @relation(fields: [branchId], references: [id])

  @@unique([companyId, branchId, docType])
}
model Invoice {
  id              String    @id @default(cuid())
  companyId       String
  branchId        String
  warehouseId     String
  customerId      String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  number          String
  status          String    @default("POSTED")
  currency        String
  exchangeRate    Decimal   @default(1) @db.Decimal(18, 8)
  subtotal        Decimal   @db.Decimal(18, 3)
  discountType    String    @default("NONE")
  discountValue   Decimal   @default(0) @db.Decimal(18, 3)
  discountAmount  Decimal   @default(0) @db.Decimal(18, 3)
  total           Decimal   @db.Decimal(18, 3)
  paidAmount      Decimal   @default(0) @db.Decimal(18, 3)
  balanceDue      Decimal   @default(0) @db.Decimal(18, 3)
  notes           String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  voidedAt        DateTime?
  voidedByUserId  String?
  voidReason      String?

  items    InvoiceItem[]
  payments Payment[]

  @@unique([companyId, number])
  @@index([companyId, branchId, createdAt])
  @@index([customerId])
}

model InvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  productId     String
  name          String
  quantity      Int
  unitPrice     Decimal @db.Decimal(18, 3)
  unitCost      Decimal @default(0) @db.Decimal(18, 3)
  discountType  String  @default("NONE")
  discountValue Decimal @default(0) @db.Decimal(18, 3)
  lineTotal     Decimal @db.Decimal(18, 3)
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  method    String
  amount    Decimal  @db.Decimal(18, 3)
  paidAt    DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model JournalEntry {
  id              String   @id @default(cuid())
  companyId       String
  branchId        String?
  entryDate       DateTime @default(now())
  description     String
  sourceType      String
  sourceId        String?
  reversalOfId    String?
  createdByUserId String
  createdAt       DateTime @default(now())

  lines JournalLine[]

  @@index([companyId, entryDate])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id         String       @id @default(cuid())
  entryId    String
  accountId  String
  customerId String?
  debit      Decimal      @default(0) @db.Decimal(18, 3)
  credit     Decimal      @default(0) @db.Decimal(18, 3)
  entry      JournalEntry @relation(fields: [entryId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([customerId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String
  action     String
  entityType String
  entityId   String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([companyId, entityType, entityId])
}
